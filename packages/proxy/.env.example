# Static routes: "<listenPort>=<targetHost>:<targetPort>", comma-separated,
# where targetHost is the L2 server as seen from the proxy (127.0.0.1 when
# they share a box, otherwise a hostname/IP/container name).
# "<listenPort>=<targetPort>" and a bare "<listenPort>" fall back to
# PROXY_TARGET_HOST. This is the mode @lineage2js/network can use as-is: the
# client only ever opens ws://<host>:<port>, so every port it would reach the
# raw TCP server on needs a route here (the login port from
# VITE_LOGIN_SERVER_PORT, plus every game server port the login server's
# ServerList advertises).
PROXY_ROUTES=2106=server:2106,7777=server:7777

# Default target host for routes that don't spell one out.
PROXY_TARGET_HOST=127.0.0.1

# Address the listeners bind to. 0.0.0.0 = every interface.
PROXY_HOST=0.0.0.0

# Optional single listener that takes its target from the URL
# (ws://proxy:8080/<targetHost>/<targetPort>). Requires PROXY_ALLOWED_TARGETS.
# PROXY_DYNAMIC_PORT=8080

# Targets the dynamic listener may connect to: "host:port", "host:*" or "*"
# for anything. Without it the proxy would be an open TCP relay, so it is
# mandatory whenever PROXY_DYNAMIC_PORT is set.
# PROXY_ALLOWED_TARGETS=server:*

# Browser Origins accepted on the WebSocket upgrade, or "*" for any.
# WebSocket has no same-origin policy of its own -- with "*", any page the
# user visits can talk to your L2 server through this proxy.
# PROXY_ALLOWED_ORIGINS=http://localhost:5173

# "packet" (default) sends one WebSocket message per L2 packet; "raw"
# forwards TCP chunks exactly as they arrive.
PROXY_FRAMING=packet

# TCP connect timeout in ms.
PROXY_CONNECT_TIMEOUT_MS=10000

# Close a session after this long with no traffic in either direction.
# 0 (default) never times out -- the game protocol can stay quiet for a while.
PROXY_IDLE_TIMEOUT_MS=0

# Max concurrent sessions across all listeners; 0 = unlimited.
PROXY_MAX_CONNECTIONS=256

# silent | error | warn | info | debug
PROXY_LOG_LEVEL=info
