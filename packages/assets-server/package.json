{
  "name": "@lineage2js/assets-server",
  "version": "0.0.1",
  "description": "Static asset server for game icons, geodata tiles and character models -- kept out of git, served with Cache-Control + ETag revalidation",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "convert:geodata": "tsx scripts/convert-l2j-geodata.ts",
    "convert:models": "tsx scripts/convert-unity-models.ts",
    "lint": "eslint src/**",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/three": "^0.185.1",
    "three": "^0.169.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
