VITE_REGISTER_URL=
VITE_RESTORE_PASSWORD_URL=
VITE_WIKI_URL=

# "{id}" is replaced with the actual id. Matches packages/assets-server's
# assets/highfive/icons/{skills,items,actions,classes} layout, e.g. served
# locally via `pnpm --filter @lineage2js/assets-server dev` on port 4000:
# VITE_SKILL_ICON_BASE_URL=http://localhost:4000/highfive/icons/skills/{id}.png
VITE_SKILL_ICON_BASE_URL=
VITE_ITEM_ICON_BASE_URL=
VITE_ACTION_ICON_BASE_URL=
VITE_CLASS_ICON_BASE_URL=

# Login screen background. Matches packages/assets-server's
# assets/legacy/{images,videos}/titlescreens layout. "{id}" is replaced with
# a random number in [1, N], where N is fetched from the server's sibling
# "count" endpoint (e.g. GET .../legacy/images/titlescreens/count), not a
# build-time env var. Video takes priority over image when both are
# available. If neither is set/available, the login screen falls back to the
# r3f atmosphere scene alone.
# VITE_LOGIN_BACKGROUND_IMAGE_BASE_URL=http://localhost:4000/legacy/images/titlescreens/{id}.jpg
# VITE_LOGIN_BACKGROUND_VIDEO_BASE_URL=http://localhost:4000/legacy/videos/titlescreens/{id}.mp4
VITE_LOGIN_BACKGROUND_IMAGE_BASE_URL=
VITE_LOGIN_BACKGROUND_VIDEO_BASE_URL=

# Raw L2J geodata region files (.l2j, one per world region -- see
# https://bitbucket.org/l2jgeo/l2j_geodata) for the terrain wireframe
# renderer. Matches packages/assets-server's assets/geodata layout
# ("{regionX}"/"{regionY}" are replaced with the region's coordinates, see
# src/config/geodata.ts). Sliced into the smaller streaming tile unit in
# memory client-side (see src/utils/geodata/l2j-region-parser.ts) -- no
# server-side re-encoding step. Generate synthetic test regions with
# `pnpm --filter @lineage2js/assets-server generate:geodata`:
# VITE_GEODATA_REGION_BASE_URL=http://localhost:4000/geodata/{regionX}_{regionY}.l2j
VITE_GEODATA_REGION_BASE_URL=

# Log verbosity for @lineage2js/network's Logger (NONE=0, INFO=1, WARNING=2,
# ERROR=4, DEBUG=8 -- bitmask, e.g. 15 for everything). Defaults to INFO.
VITE_L2JSC_LOG_LEVEL=

# L2 login server address. The game server's own address/port come from the
# login server's ServerList response, not from an env var. Defaults to
# 127.0.0.1:2106 (the network package's own MMOConfig defaults) if unset.
# The server must speak the login protocol over WebSocket (ws:// by default,
# see VITE_LOGIN_SERVER_SECURE for wss://) -- a raw TCP L2 server needs a
# ws<->tcp proxy in front of it, since browsers cannot open raw TCP sockets.
VITE_LOGIN_SERVER_IP=
VITE_LOGIN_SERVER_PORT=

# "true" connects via wss:// instead of ws://. Required whenever this app
# itself is served over https (e.g. GitHub Pages) -- browsers block a plain
# ws:// connection from an https page as mixed content, the same way they'd
# block an http:// fetch() (see the icon/geodata URLs above). The login
# server (and whatever game server it hands off to -- same Secure flag
# carries over automatically, see MMOConfig.Secure) must actually terminate
# TLS for this to work, e.g. via a reverse proxy (nginx/Caddy) or tunnel in
# front of it -- this flag only changes what the *client* requests, it can't
# make an insecure server speak TLS.
VITE_LOGIN_SERVER_SECURE=
