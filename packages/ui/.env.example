VITE_REGISTER_URL=
VITE_RESTORE_PASSWORD_URL=
VITE_WIKI_URL=

# Base URL of the *folder* for each icon kind -- no "{id}" placeholder here
# anymore. src/config/icon-urls.ts's loadIconMaps() fetches "index.json" from
# that same folder once at startup (an id -> actual filename map, since a
# filename doesn't always match its id 1:1) and resolves individual icons
# through it from then on. Matches packages/assets-server's
# assets/highfive/icons/{skills,items,actions,classes} layout, e.g. served
# locally via `pnpm --filter @lineage2js/assets-server dev` on port 4000:
# VITE_SKILL_ICON_BASE_URL=http://localhost:4000/highfive/icons/skills/
VITE_SKILL_ICON_BASE_URL=
VITE_ITEM_ICON_BASE_URL=
VITE_ACTION_ICON_BASE_URL=
VITE_CLASS_ICON_BASE_URL=

# The other two icon sets resolve through a hard-coded id -> filename map in
# src/config/icon-urls.ts rather than a fetched index, so they need no sibling
# "index.json" -- but they are read, typed and passed through the Pages
# workflow like the rest, and a body without them simply falls back to the
# gradient. The race art matches assets-server's assets/highfive/icons/races.
# VITE_RACE_ICON_BASE_URL=http://localhost:4000/highfive/icons/races/
VITE_SLOT_ICON_BASE_URL=
VITE_RACE_ICON_BASE_URL=

# Folder of the game menu's own button icons, matching packages/assets-server's
# assets/highfive/icons/game-menu layout. No "index.json" here -- each file is
# named after its button ("character@64.png", "inventory@64.png", ...), see
# src/config/icon-urls.ts's getGameMenuIconUrl. The menu falls back to plain
# glyphs when this is unset, so the app stays usable without the art (which is
# copyrighted client material and deliberately not part of this repo).
# VITE_GAME_MENU_ICON_BASE_URL=http://localhost:4000/highfive/icons/game-menu/
VITE_GAME_MENU_ICON_BASE_URL=

# Login screen background. Matches packages/assets-server's
# assets/legacy/{images,videos}/titlescreens layout. "{id}" is replaced with
# a random number in [1, N], where N is fetched from the server's sibling
# "count" endpoint (e.g. GET .../legacy/images/titlescreens/count), not a
# build-time env var. Video takes priority over image when both are
# available. If neither is set/available, the login screen falls back to the
# r3f atmosphere scene alone.
# VITE_LOGIN_BACKGROUND_IMAGE_BASE_URL=http://localhost:4000/legacy/images/titlescreens/{id}.jpg
# VITE_LOGIN_BACKGROUND_VIDEO_BASE_URL=http://localhost:4000/legacy/videos/titlescreens/{id}.mp4
VITE_LOGIN_BACKGROUND_IMAGE_BASE_URL=
VITE_LOGIN_BACKGROUND_VIDEO_BASE_URL=

# Pre-baked geodata tiles for the terrain wireframe renderer. Matches
# packages/assets-server's assets/highfive/geodata-tiles layout
# ("{tileX}"/"{tileY}" are replaced with the tile's coordinates, see
# src/config/geodata.ts). Deserialized directly client-side (see
# src/utils/geodata/geo-tile-parser.ts) -- the expensive CSR multilayer
# decode from raw .l2j region files (https://bitbucket.org/l2jgeo/l2j_geodata)
# happens once, offline: drop real .l2j files into
# packages/assets-server/assets/highfive/geodata/ and run
# `pnpm --filter @lineage2js/assets-server convert:geodata`.
# VITE_GEODATA_TILE_BASE_URL=http://localhost:4000/highfive/geodata-tiles/{tileX}_{tileY}.bin
VITE_GEODATA_TILE_BASE_URL=

# Converted character bodies -- the *folder*, one "<rig>.glb" per race/sex
# (mfighter, felf, mdwarf, ...). Matches packages/assets-server's
# assets/highfive/models layout. Built offline out of an installed game client
# with `pnpm --filter @lineage2js/assets-server convert:client-rigs --
# --client <dir> --umodel <umodel.exe>`, which produces the textures below in
# the same run. Unset, or a body that doesn't load, leaves that character on
# the procedural placeholder -- which is also all a mob or a summon ever gets.
# VITE_CHARACTER_MODEL_BASE_URL=http://localhost:4000/highfive/models/
VITE_CHARACTER_MODEL_BASE_URL=

# Converted character textures, produced alongside the bodies by
# `pnpm --filter @lineage2js/assets-server convert:client-rigs`. Laid out as
# <rig>/<part>-<variant>.png next to an index.json listing what each rig has.
# Two of the parts vary by the character's own appearance -- three faces and
# four hair colours, both texture swaps in retail rather than new geometry.
# Unset, or a part with no texture, leaves that part on the flat colour it is
# tinted with instead.
# VITE_CHARACTER_TEXTURE_BASE_URL=http://localhost:4000/highfive/textures/
VITE_CHARACTER_TEXTURE_BASE_URL=

# "true" stitches geodata tiles into a continuous mesh across cell/layer
# boundaries at any height difference (buildSheets in
# geo-terrain-tile.component.tsx). Leave unset for the default: one
# independent quad per (cell, layer), no shared vertices between cells --
# matches how the real G3D geodata editor renders it (confirmed by
# decompiling G3DEditor.jar). Full stitching is opt-in since "closest
# available match" has no ground-truth reference to validate against,
# unlike independent quads.
#
# This is not the switch for smooth-looking terrain: the default mode
# already welds quad corners whose layers are within
# GEO_TERRAIN_WELD_MAX_DELTA (src/config/geodata.ts) of each other, so
# ordinary ground -- which the bake quantizes into 8-unit Z steps -- comes
# out continuous with this unset.
VITE_GEODATA_TERRAIN_SMOOTH=

# Log verbosity for @lineage2js/network's Logger (NONE=0, INFO=1, WARNING=2,
# ERROR=4, DEBUG=8 -- bitmask, e.g. 15 for everything). Defaults to INFO.
VITE_L2JSC_LOG_LEVEL=

# "true" seeds GameStore with fake placeholder data (inventory, skills,
# party, char stats, hotbar, ...) so every window has something to show with
# no server connection -- handy for UI development/screenshots. Leave unset
# for real network testing, so GameStore starts empty/neutral instead and
# never shows demo data mixed in with real server data (see config/env.ts).
VITE_IS_DEMO_MODE=

# Local dev convenience: prefills the login form's account/password (never
# auto-submits) so a test account doesn't need retyping on every reload. Only
# read in dev builds (import.meta.env.DEV -- see config/env.ts), stripped
# entirely from `vite build`'s production output. DO NOT put a real password
# here in .env.example or a committed .env -- set it only in your own
# .env.local (gitignored, and kept separate from .env on purpose so a real
# credential never ends up in a .env someone shares/copies around).
VITE_DEV_LOGIN_USERNAME=
VITE_DEV_LOGIN_PASSWORD=

# L2 login server address. The game server's own address/port come from the
# login server's ServerList response, not from an env var. Defaults to
# 127.0.0.1:2106 (the network package's own MMOConfig defaults) if unset.
# The server must speak the login protocol over WebSocket (ws:// by default,
# see VITE_LOGIN_SERVER_SECURE for wss://) -- a raw TCP L2 server needs a
# ws<->tcp proxy in front of it, since browsers cannot open raw TCP sockets.
VITE_LOGIN_SERVER_IP=
VITE_LOGIN_SERVER_PORT=

# "true" connects via wss:// instead of ws://. Required whenever this app
# itself is served over https (e.g. GitHub Pages) -- browsers block a plain
# ws:// connection from an https page as mixed content, the same way they'd
# block an http:// fetch() (see the icon/geodata URLs above). The login
# server (and whatever game server it hands off to -- same Secure flag
# carries over automatically, see MMOConfig.Secure) must actually terminate
# TLS for this to work, e.g. via a reverse proxy (nginx/Caddy) or tunnel in
# front of it -- this flag only changes what the *client* requests, it can't
# make an insecure server speak TLS.
VITE_LOGIN_SERVER_SECURE=
